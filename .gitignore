```gitignore
# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Dependencies
.venv/
venv/
env/
Pipfile.lock
poetry.lock

# Logs and temp files
*.log
*.tmp
*.swp

# Environment variables
.env
.env.local
.env.*

# Editors
.vscode/
.idea/
*.swp
*.swo

# Build artifacts
build/
dist/
*.egg-info/
.coverage
htmlcov/
.mypy_cache/
.pytest_cache/
```